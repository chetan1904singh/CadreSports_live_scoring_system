generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MatchStatus {
  SCHEDULED
  LIVE
  PAUSED
  ENDED
}

enum ScoringEventType {
  MATCH_STARTED
  MATCH_PAUSED
  MATCH_RESUMED
  MATCH_ENDED
  GOAL
  GOAL_UNDONE
}

model Team {
  id          String          @id @default(cuid())
  name        String
  homeMatches FootballMatch[] @relation("HomeTeam")
  awayMatches FootballMatch[] @relation("AwayTeam")
  goals       ScoringEvent[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model FootballMatch {
  id         String         @id @default(cuid())
  homeTeamId String
  awayTeamId String
  homeTeam   Team           @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam   Team           @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  status     MatchStatus    @default(SCHEDULED)
  homeScore  Int            @default(0)
  awayScore  Int            @default(0)
  version    Int            @default(0)
  events     ScoringEvent[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status, updatedAt])
}

model ScoringEvent {
  id             String           @id @default(cuid())
  matchId        String
  match          FootballMatch    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sequence       Int
  type           ScoringEventType
  teamId         String?
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  playerName     String?
  minute         Int?
  addedMinute    Int?
  relatedEventId String?
  relatedEvent   ScoringEvent?    @relation("UndoneGoal", fields: [relatedEventId], references: [id], onDelete: Restrict)
  undoEvents     ScoringEvent[]   @relation("UndoneGoal")
  createdAt      DateTime         @default(now())

  @@unique([matchId, sequence])
  @@index([matchId, createdAt])
  @@index([relatedEventId])
}
